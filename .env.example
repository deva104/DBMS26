# Copy this file to .env and fill in the values from the Aiven console
# (Service -> Overview -> Connection information).
DB_HOST=mysql-xxxxxxxx-yourproject.l.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=library_db

# Web server port (Render sets PORT automatically)
PORT=3000

# Only needed on Render: paste the full text of ca.pem here.
# Locally the app reads ./ca.pem instead.
# DB_CA=-----BEGIN CERTIFICATE-----...
